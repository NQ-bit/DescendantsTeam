  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  dialogueText: {fileID: 841031211}
  dialogues:
  - 'My dreams have always been memories lurking in the dark corners of my mind. '
  - And within those dark corners I see it.
  - "The monster\u2019s lurking in the darkness."
  - "Even the daylight breaking through my window doesn\u2019t dissipate the shadows. "
  - "It\u2019s paralyzing."
  - Yet another day dawns.
  - "It\u2019s time to get up and see what it holds."
  typingSpeed: 0.05
  dialogueBox: {fileID: 1158191472}
  arrowIndicator: {fileID: 265375505}
